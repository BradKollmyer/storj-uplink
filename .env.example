# Credentials for live satellite tests. Copy to `.env` in this directory or a
# parent directory. Existing process environment wins over values here.
#
# This file does not enable the tests. They are #[ignore] and also need:
#   STORJ_LIVE=1 cargo test -p storj --test live -- --ignored --nocapture
#
STORJ_ACCESS=

# Optional. When set, live tests write into this bucket (under a unique
# object-key prefix) instead of creating a unique bucket, and they do not
# delete the bucket afterwards.
# STORJ_BUCKET=storj-test
